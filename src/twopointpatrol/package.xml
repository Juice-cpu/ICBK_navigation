  <version>0.0.0</version>
  <description>A simple ROS 2 patrol package with C++ nodes</description>
  <maintainer email="juice@example.com">Your Name</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
